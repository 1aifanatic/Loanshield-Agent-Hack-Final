NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_TITLE=LoanShield Demo Portal
NEXT_PUBLIC_POLL_INTERVAL_MS=3000

# Optional locally. Required for persistent hosted demos.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# UiPath HTTP Webhook generated URL. Never commit a live generated URL.
UIPATH_WEBHOOK_URL=<UIPATH_GENERATED_WEBHOOK_URL>
UIPATH_WEBHOOK_API_KEY=<UIPATH_WEBHOOK_API_KEY>

# UiPath callback key expected by /api/uipath/case-updates and /api/uipath/case-context.
UIPATH_CALLBACK_API_KEY=<UIPATH_CALLBACK_API_KEY>
UIPATH_CALLBACK_HMAC_SECRET=

DEMO_USERNAME=demo
DEMO_PASSWORD=demo123
DEMO_SESSION_TOKEN=replace-with-long-random-string
DEMO_ADMIN_TOKEN=replace-with-long-random-string
ENABLE_DEV_RESET=false
