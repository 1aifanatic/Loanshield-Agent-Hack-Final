            <uipath:output name="UserSelectStageMessageResponse" type="jsonSchema" var="UserSelectStageMessageResponse" custom="true"><![CDATA[=js:(vars.EventSubProcessLatestEventType == "TaskCompleted" && (vars.EventSubProcessLatestEventParams != null && vars.EventSubProcessLatestEventParams.taskName != null && =js:["Wait for User to Select Next Stage for Integration Error Recovery", "Wait for User to Select Next Stage for Appeal / Reopen", "Wait for User to Select Next Stage for Withdrawn Case", "Wait for User to Select Next Stage for Duplicate Case", "Wait for User to Select Next Stage for SLA Escalation", "Wait for User to Select Next Stage for Credit Bureau Impact Review", "Wait for User to Select Next Stage for Compliance / AML Referral", "Wait for User to Select Next Stage for Manager Review", "Wait for User to Select Next Stage for Vulnerable Customer Review", "Wait for User to Select Next Stage for Fraud Hold", "Wait for User to Select Next Stage for Pending Customer Information", "Wait for User to Select Next Stage for Closure and Audit QA", "Wait for User to Select Next Stage for Customer Communication", "Wait for User to Select Next Stage for Settlement and Correction", "Wait for User to Select Next Stage for Human Decision", "Wait for User to Select Next Stage for Parallel Servicing / Fraud Investigation", "Wait for User to Select Next Stage for Evidence Collection", "Wait for User to Select Next Stage for Eligibility and Policy Triage", "Wait for User to Select Next Stage for Loan Context Retrieval", "Wait for User to Select Next Stage for Demo Intake"].some((task) => task == vars.EventSubProcessLatestEventParams.taskName)) ? {} : vars.UserSelectStageMessageResponse)]]></uipath:output>
