{
  "$schema": "https://cloud.uipath.com/draft/2024-12/entry-point",
  "$id": "entry-points.json",
  "entryPoints": [
    {
      "filePath": "/content/agent.json",
      "uniqueId": "be5481f3-1189-4ccc-9946-3524f263a13e",
      "type": "agent",
      "input": {
        "type": "object",
        "properties": {
          "caseJson": {
            "type": "object",
            "description": "Canonical LoanShield case, webhook, context, evidence, policy, investigation, decision, and callback state."
          }
        },
        "required": [
          "caseJson"
        ]
      },
      "output": {
        "type": "object",
        "properties": {
          "caseType": {
            "type": "string",
            "description": "loan_dispute or loan_scam"
          },
          "disputeType": {
            "type": "string",
            "description": "Normalized dispute or scam type"
          },
          "confidence": {
            "type": "number",
            "description": "Classification confidence from 0 to 1"
          },
          "priority": {
            "type": "string",
            "description": "normal, high, or urgent"
          },
          "requiredHumanReview": {
            "type": "boolean",
            "description": "True when intake needs human review"
          },
          "summary": {
            "type": "string",
            "description": "Brief intake summary for the portal timeline"
          }
        }
      }
    }
  ]
}
