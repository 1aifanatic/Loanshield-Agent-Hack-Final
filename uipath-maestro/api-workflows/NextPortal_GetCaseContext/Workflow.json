                "configuration": "{\"essentialConfiguration\":{\"connectorVersion\":\"\",\"executionType\":null,\"customFieldsRequestDetails\":null,\"instanceParameters\":{\"version\":\"1.0.0\",\"connectorKey\":\"uipath-uipath-http\",\"activityType\":\"Curated\",\"objectName\":\"http-request\",\"httpMethod\":\"POST\",\"operation\":null,\"eventOperation\":null,\"eventMode\":null,\"connectorObjects\":null,\"previewEndpoint\":null},\"objectName\":\"http-request\",\"operation\":null,\"packageVersion\":\"1.0.0\",\"httpMethod\":\"POST\",\"path\":\"/http-request\",\"unifiedTypesCompatible\":true,\"savedJitInputFieldId\":\"in_http-request\"}}"
              }
            }
          },
          {
            "Javascript_1": {
              "run": {
                "script": {
                  "code": "const input = $workflow.input || {}; const response = $context.outputs.http_request_1 || {}; const content = response.content ?? response.body ?? {}; let body = content; if ((!body || Object.keys(body).length === 0) && response.rawStringBody) { try { body = JSON.parse(response.rawStringBody); } catch (_) { body = { rawStringBody: response.rawStringBody }; } } const statusCode = Number(response.code ?? response.statusCode ?? response.status ?? 0); const caseContext = body?.data ?? body; return { mode: 'live-vercel', statusCode, found: statusCode >= 200 && statusCode < 300, externalCaseKey: input.externalCaseKey, source: 'LoanShield Demo Portal', retrievedAt: new Date().toISOString(), caseContext };",
                  "language": "javascript",
                  "arguments": "${{ \"$context\": $context, \"$workflow\": $workflow, \"$input\": $input }}"
                }
              },
              "export": { "as": "{ ...$context, outputs: { ...$context?.outputs, \"Javascript_1\": $output } }" },
              "metadata": { "activityType": "JsInvoke", "displayName": "Normalize LoanShield context response", "fullName": "JsInvoke" }
