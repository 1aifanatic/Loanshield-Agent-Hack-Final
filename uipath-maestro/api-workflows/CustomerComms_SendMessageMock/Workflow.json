{
  "document": { "dsl": "1.0.0", "name": "CustomerComms_SendMessageMock", "version": "0.0.1", "namespace": "loanshield", "metadata": { "variables": { "schema": { "format": "json", "document": { "type": "object", "properties": {}, "title": "Variables" } } } } },
