  "output": { "schema": { "format": "json", "document": { "type": "object", "properties": { "communicationStatus": { "type": "string" }, "messageReference": { "type": "string" }, "callbackEventType": { "type": "string" } }, "title": "Outputs" } } },
  "do": [
